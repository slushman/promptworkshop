{
	"main": "dist/_worker.js/index.js",
	"name": "promptworkshop",
	"compatibility_date": "2026-02-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"d1_databases": [
		{
			"binding": "promptworkshop",
			"database_name": "promptworkshop",
			"database_id": "6c485bc9-759d-45c4-8f26-b71dd0bda4e3",
			"remote": true
		}
	],
	"observability": {
		"enabled": true
	}
}