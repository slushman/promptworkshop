{
	"main": "dist/_worker.js/index.js",
	"name": "promptworkshop",
	"compatibility_date": "2026-02-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"d1_databases": [
		{
			"binding": "promptworkshop",
			"database_name": "promptworkshop",
			"database_id": "6c485bc9-759d-45c4-8f26-b71dd0bda4e3",
			"remote": true
		}
	],
	"vars": {
		"ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
		"ACCESS_AUD": "c3a6d1acf67ab7c3bdc4ff7520e94eb01757113979e5e012014f0d8869b62c16"
	},
	"observability": {
		"enabled": true
	}
}